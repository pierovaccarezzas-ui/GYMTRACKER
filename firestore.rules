rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validRecord() {
      let data = request.resource.data;
      return data.keys().hasOnly(['schema','path','value','deleted','revision','updatedAt'])
        && data.keys().hasAll(['schema','path','value','deleted','revision','updatedAt'])
        && data.schema == 1
        && data.path is list && data.path.size() >= 1 && data.path.size() <= 12
        && !data.path.hasAny(['__proto__','constructor','prototype'])
        && data.path[0] in ['done','custom','addedEx','deletedEx','runs','routine',
          'sessionExercises','customSessions','deletedSessions','sessionWarmups',
          'todaySelection','routineOrder','sessionMeta','legacyArchive','weeks']
        && data.deleted is bool
        && data.revision is string && data.revision.size() > 0 && data.revision.size() <= 100
        && data.updatedAt == request.time;
    }
    match /users/{uid}/records/{recordId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validRecord();
      // Deletions are retained as tombstones to prevent offline resurrection.
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
